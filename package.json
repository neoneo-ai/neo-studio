{
  "name": "neo-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --test-force-exit --test-timeout=30000 \"studio/tests/js/*.test.mjs\"",
    "test:ci": "node --test --test-force-exit --test-timeout=30000 --test-concurrency=1 \"studio/tests/js/*.test.mjs\"",

    "e2e": "node --test --test-force-exit --test-concurrency=4 --test-timeout=120000 \"studio/tests/e2e/*.e2e.mjs\"",
    "update-goldens": "node --env-file=studio/tests/js/golden-update.env --test --test-force-exit --test-timeout=30000 \"studio/tests/js/*.test.mjs\""
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.31"
  }
}
